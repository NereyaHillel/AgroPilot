# Database. Without DATABASE_URL the service uses registry.db next to the code (SQLite).
# Local development (SQLite):
DATABASE_URL=sqlite:///registry.db
# Production (PostgreSQL 12 or later): comment the line above and use this one.
# DATABASE_URL=postgresql://user:password@host:5432/registry

# Plot photos (S3). Without AWS_S3_BUCKET the photo routes answer 503.
# Credentials are not set here: boto3 finds them itself (environment, ~/.aws, or an instance role).
AWS_S3_BUCKET=
AWS_REGION=

# Open-Meteo (the provider). The free tier needs no key.
PROVIDER_BASE_URL=https://api.open-meteo.com
# Leave empty on the free tier. When set, it is sent as the `apikey` query parameter.
PROVIDER_API_KEY=
# Seconds to wait for the provider on each attempt.
PROVIDER_TIMEOUT_SECONDS=5
# Retries after the first failed attempt (2 retries = 3 attempts in total).
PROVIDER_RETRIES=2
# Pause between attempts, in seconds.
PROVIDER_RETRY_PAUSE_SECONDS=0.5
# A forecast is fresh for this long (3 hours); while fresh the provider is not called.
FRESH_SECONDS=10800
# Oldest forecast still served, marked stale (24 hours). See README.
MAX_STALE_SECONDS=86400
